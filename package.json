{
  "name": "qupi-apps",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev:container",
    "build:auth": "npm run build -w apps/auth",
    "build:wallet": "npm run build -w apps/wallet",
    "build:credit": "npm run build -w apps/credit",
    "build:container": "npm run build -w apps/container",
    "build": "npm run build:auth && npm run build:wallet && npm run build:credit && npm run build:container",
    "dev:container": "npm run dev -w apps/container",
    "dev:auth": "npm run dev -w apps/auth",
    "dev:wallet": "npm run dev -w apps/wallet",
    "dev:credit": "npm run dev -w apps/credit"
  }
}